# ==============================================================
# CodeInsight Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file and rename it to '.env' in your local setup.
# 2. Fill in your actual local MySQL credentials.
# 3. NEVER commit your actual '.env' file to GitHub!
# ==============================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codeinsight_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Server Configuration
SERVER_PORT=8080

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
